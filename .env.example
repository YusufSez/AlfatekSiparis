# API
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=change-me-in-production
DATABASE_URL="file:./dev.db"
# Virgülle birden fazla origin. Production'da zorunlu; * yasak. Dev'de LAN Vite origin'leri otomatik.
CORS_ORIGIN=http://localhost:5173
# Reverse proxy arkasında (nginx X-Forwarded-For overwrite ile) açın: TRUST_PROXY=1
# TRUST_PROXY=1
# TRUST_PROXY_HOPS=1
BUILD_DATE=
GIT_COMMIT=

# Production metrics scrape token (Bearer veya X-Metrics-Token) — prod'da zorunlu
# METRICS_TOKEN=

# Web (apps/web)
# Development: boş bırakın → sayfa hostname + :4000 (telefondan LAN IP çalışır)
# Production build: mutlaka absolute API URL verin
# VITE_API_URL=http://localhost:4000
# VITE_API_PORT=4000

# Web Push (VAPID) — npx web-push generate-vapid-keys
# Production'da zorunlu
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:admin@example.com
# Frontend build: VITE_VAPID_PUBLIC_KEY= (same as VAPID_PUBLIC_KEY)

# Production first-admin bootstrap (NODE_ENV=production only).
# Set all three once on first deploy; remove after first successful login.
# ADMIN_NAME=Sistem Yöneticisi
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
