# Telefondan / LAN testi için örnek (apps/web/.env.local)
#
# Bu dosyayı kopyalayın:
#   cp .env.local.example .env.local
#
# Development'ta VITE_API_URL boş bırakılırsa frontend otomatik olarak
# tarayıcının hostname'ini kullanır:
#   http://192.168.1.42:5173  →  API http://192.168.1.42:4000
#   http://localhost:5173     →  API http://localhost:4000
#
# Yerel makinede API adresini sabitlemek isterseniz:
# VITE_API_URL=http://localhost:4000
#
# API portu farklıysa:
# VITE_API_PORT=4000
#
# Not: .env.local git'e eklenmez; yalnızca geliştirici makinesinde kullanılır.
