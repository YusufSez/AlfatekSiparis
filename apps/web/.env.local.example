# Telefondan / LAN testi için örnek (apps/web/.env.local)
#
# Bu dosyayı kopyalayın:
#   cp .env.local.example .env.local
#
# ÖNEMLİ: VITE_API_URL tanımlamayın / boş bırakın.
# Development'ta API otomatik:
#   http://192.168.1.42:5173  →  http://192.168.1.42:4000
#   http://localhost:5173     →  http://localhost:4000
#
# Telefonda testte VITE_API_URL=http://localhost:4000 KULLANMAYIN.
#
# API portu farklıysa:
# VITE_API_PORT=4000
#
# Not: .env.local git'e eklenmez.
