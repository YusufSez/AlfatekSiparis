# Production / packaged Electron: URL of the deployed web SPA
# (same origin users open in the browser).
# If unset, bake-start-url.js defaults to https://alfateksiparis-1.onrender.com
# DESKTOP_START_URL=https://alfateksiparis-1.onrender.com

# Dev (optional): defaults to http://127.0.0.1:5173 when unset and unpackaged
# DESKTOP_START_URL=http://127.0.0.1:5173
