# Local API development overrides (optional).
# Copy to .env.development and fill in — this file is never loaded in production.
# Production uses process env / Docker secrets only (see docker-compose.prod.yml).

PORT=4000
HOST=0.0.0.0
# Generate locally: openssl rand -hex 32
JWT_SECRET=
DATABASE_URL="file:./dev.db"
CORS_ORIGIN=http://localhost:5173
SESSION_DURATION_SEC=120
# TRUST_PROXY=1
# TRUST_PROXY_HOPS=1

# When true, session open also notifies the opener (single-user / own-phone push test).
# Default false = peers only.
# NOTIFY_SELF_ON_OPEN=true
