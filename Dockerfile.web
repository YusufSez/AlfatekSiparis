# syntax=docker/dockerfile:1
# Render Web service — mirrors root Dockerfile `web-build` + `web` stages.
# Context: repository root. Do not use for docker-compose (keep root Dockerfile + target).
# Build args (required for production frontend): VITE_API_URL, VITE_VAPID_PUBLIC_KEY

FROM node:22-alpine AS web-build
WORKDIR /app
ARG VITE_API_URL=
ARG VITE_VAPID_PUBLIC_KEY=
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_VAPID_PUBLIC_KEY=$VITE_VAPID_PUBLIC_KEY
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/package.json
RUN npm ci -w apps/web
COPY apps/web ./apps/web
RUN npm run build -w apps/web

FROM nginx:1.27-alpine
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=web-build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
